@inject ModuleStateService ModuleState
@inject NavigationManager Nav
@inject IAuthService AuthService

<MudNavMenu Rounded="true" Margin="Margin.Dense" Color="Color.Primary" Class="pa-2">
    <div class="px-3 py-2 mb-2 d-flex align-center gap-2">
        <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Medium">
            <MudIcon Icon="@Icons.Material.Filled.Business" />
        </MudAvatar>
        <div>
            <MudText Typo="Typo.subtitle2" Style="font-weight: 700; line-height: 1.1;">ERP WEB MATRIX</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-size: 11px;">Gestão Empresarial</MudText>
        </div>
    </div>

    <MudDivider Class="my-2" />

    <MudNavLink Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard" Href="/" OnClick="@(() => ModuleState.SetActiveModule(ModuloSistema.Comercial))">
        Dashboard Geral
    </MudNavLink>

    <!-- MÓDULO COMERCIAL -->
    <MudNavGroup Title="Comercial & CRM" Icon="@Icons.Material.Filled.Storefront" Expanded="true">
        <MudNavLink Icon="@Icons.Material.Filled.Group" Href="/comercial/mailing" OnClick="@(() => ModuleState.SetActiveModule(ModuloSistema.Comercial))">
            Mailing (Central)
        </MudNavLink>
        <MudNavLink Icon="@Icons.Material.Filled.ViewKanban" Href="/comercial/crm" OnClick="@(() => ModuleState.SetActiveModule(ModuloSistema.Comercial))">
            CRM Kanban
        </MudNavLink>
        <MudNavLink Icon="@Icons.Material.Filled.ShoppingCart" Href="/comercial/vendas" OnClick="@(() => ModuleState.SetActiveModule(ModuloSistema.Comercial))">
            Pedidos de Venda
        </MudNavLink>
    </MudNavGroup>

    <!-- MÓDULO ESTOQUE -->
    <MudNavGroup Title="Estoque & Materiais" Icon="@Icons.Material.Filled.Inventory2" Expanded="false">
        <MudNavLink Icon="@Icons.Material.Filled.Category" Href="/estoque/produtos" OnClick="@(() => ModuleState.SetActiveModule(ModuloSistema.Estoque))">
            Produtos & Saldo
        </MudNavLink>
    </MudNavGroup>

    <!-- MÓDULO FINANCEIRO -->
    <MudNavGroup Title="Financeiro" Icon="@Icons.Material.Filled.AccountBalance" Expanded="false">
        <MudNavLink Icon="@Icons.Material.Filled.AttachMoney" Href="/financeiro" OnClick="@(() => ModuleState.SetActiveModule(ModuloSistema.Financeiro))">
            Contas & Fluxo Caixa
        </MudNavLink>
    </MudNavGroup>

    <!-- MÓDULO FATURAMENTO -->
    <MudNavGroup Title="Faturamento Fiscal" Icon="@Icons.Material.Filled.Receipt" Expanded="false">
        <MudNavLink Icon="@Icons.Material.Filled.Description" Href="/faturamento" OnClick="@(() => ModuleState.SetActiveModule(ModuloSistema.Faturamento))">
            Notas Fiscais (NF-e)
        </MudNavLink>
    </MudNavGroup>

    <!-- MÓDULO SISTEMA / ADMIN -->
    <MudNavGroup Title="Administração" Icon="@Icons.Material.Filled.AdminPanelSettings" Expanded="false">
        <MudNavLink Icon="@Icons.Material.Filled.Security" Href="/sistema/rbac" OnClick="@(() => ModuleState.SetActiveModule(ModuloSistema.Sistema))">
            Perfis e RBAC
        </MudNavLink>
        <MudNavLink Icon="@Icons.Material.Filled.History" Href="/sistema/audit" OnClick="@(() => ModuleState.SetActiveModule(ModuloSistema.Sistema))">
            Audit Trail (Logs)
        </MudNavLink>
    </MudNavGroup>
</MudNavMenu>
