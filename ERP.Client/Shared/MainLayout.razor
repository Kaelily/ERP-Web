@inherits LayoutComponentBase
@inject IAuthService AuthService
@inject NavigationManager Nav
@inject SignalRNotificationService SignalRService
@inject ModuleStateService ModuleState

<MudThemeProvider Theme="_theme" @bind-IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    @if (AuthService.CurrentUser != null)
    {
        <!-- APPBAR SUPERIOR -->
        <MudAppBar Elevation="1" Dense="true" Color="Color.Surface" Style="border-bottom: 1px solid var(--mud-palette-lines-default);">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@(() => _drawerOpen = !_drawerOpen)" />
            
            <img src="images/azurra-logo.png" alt="Azurra System" style="height: 32px; object-fit: contain;" Class="ml-2 mr-4" />

            <!-- SELETOR DE MÓDULO RÁPIDO NO TOPO -->
            <div class="d-none d-md-flex align-center ml-6 gap-1">
                <MudChip T="string" Color="@(ModuleState.ActiveModule == ModuloSistema.Comercial ? Color.Primary : Color.Default)"
                         Variant="@(ModuleState.ActiveModule == ModuloSistema.Comercial ? Variant.Filled : Variant.Text)"
                         Size="Size.Small" OnClick="@(() => SetModule(ModuloSistema.Comercial, "/comercial/mailing"))">
                    Comercial
                </MudChip>
                <MudChip T="string" Color="@(ModuleState.ActiveModule == ModuloSistema.Estoque ? Color.Primary : Color.Default)"
                         Variant="@(ModuleState.ActiveModule == ModuloSistema.Estoque ? Variant.Filled : Variant.Text)"
                         Size="Size.Small" OnClick="@(() => SetModule(ModuloSistema.Estoque, "/estoque/produtos"))">
                    Estoque
                </MudChip>
                <MudChip T="string" Color="@(ModuleState.ActiveModule == ModuloSistema.Financeiro ? Color.Primary : Color.Default)"
                         Variant="@(ModuleState.ActiveModule == ModuloSistema.Financeiro ? Variant.Filled : Variant.Text)"
                         Size="Size.Small" OnClick="@(() => SetModule(ModuloSistema.Financeiro, "/financeiro"))">
                    Financeiro
                </MudChip>
                <MudChip T="string" Color="@(ModuleState.ActiveModule == ModuloSistema.Faturamento ? Color.Primary : Color.Default)"
                         Variant="@(ModuleState.ActiveModule == ModuloSistema.Faturamento ? Variant.Filled : Variant.Text)"
                         Size="Size.Small" OnClick="@(() => SetModule(ModuloSistema.Faturamento, "/faturamento"))">
                    Faturamento
                </MudChip>
                <MudChip T="string" Color="@(ModuleState.ActiveModule == ModuloSistema.Sistema ? Color.Primary : Color.Default)"
                         Variant="@(ModuleState.ActiveModule == ModuloSistema.Sistema ? Variant.Filled : Variant.Text)"
                         Size="Size.Small" OnClick="@(() => SetModule(ModuloSistema.Sistema, "/sistema/rbac"))">
                    Sistema
                </MudChip>
            </div>

            <MudSpacer />

            <!-- AÇÕES DO TOPO -->
            <MudTooltip Text="Alternar Tema Claro / Escuro">
                <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                               Color="Color.Inherit" OnClick="@(() => _isDarkMode = !_isDarkMode)" />
            </MudTooltip>

            <MudTooltip Text="Notificações em Tempo Real">
                <MudBadge Content="3" Color="Color.Error" Overlap="true" Class="mx-2">
                    <MudIconButton Icon="@Icons.Material.Filled.Notifications" Color="Color.Inherit" />
                </MudBadge>
            </MudTooltip>

            <!-- USUÁRIO LOGADO -->
            <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Dense="true">
                <ActivatorContent>
                    <div class="d-flex align-center gap-2 cursor-pointer ml-2">
                        <MudAvatar Color="Color.Primary" Size="Size.Small">
                            @AuthService.CurrentUser.Nome.Substring(0, 1)
                        </MudAvatar>
                        <div class="d-none d-sm-block text-left" style="line-height: 1.1;">
                            <MudText Typo="Typo.caption" Style="font-weight: 600;">@AuthService.CurrentUser.Nome</MudText>
                            <br />
                            <MudText Typo="Typo.caption" Style="font-size: 10px; color: var(--mud-palette-text-secondary);">
                                @AuthService.CurrentUser.PerfilNome
                            </MudText>
                        </div>
                        <MudIcon Icon="@Icons.Material.Filled.ArrowDropDown" Size="Size.Small" />
                    </div>
                </ActivatorContent>
                <ChildContent>
                    <MudMenuItem Icon="@Icons.Material.Filled.Person">Meu Perfil</MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Filled.Security" OnClick="@(() => Nav.NavigateTo("/sistema/rbac"))">Permissões</MudMenuItem>
                    <MudDivider />
                    <MudMenuItem Icon="@Icons.Material.Filled.Logout" IconColor="Color.Error" OnClick="HandleLogout">
                        Sair (Logout)
                    </MudMenuItem>
                </ChildContent>
            </MudMenu>
        </MudAppBar>

        <!-- SIDEBAR DRAWER -->
        <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Docked" Elevation="2" Variant="DrawerVariant.Responsive">
            <NavMenu />
        </MudDrawer>
    }

    <!-- CONTEÚDO PRINCIPAL -->
    <MudMainContent Style="display: flex; flex-direction: column; min-height: 100vh;">
        @if (AuthService.CurrentUser != null)
        {
            <!-- RIBBON TOOLBAR -->
            <RibbonMenu />
        }

        <!-- PÁGINA ATUAL -->
        <div class="pa-4 pa-md-6" style="flex: 1;">
            @Body
        </div>

        @if (AuthService.CurrentUser != null)
        {
            <!-- STATUS BAR INFERIOR -->
            <StatusBar />
        }
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private bool _isDarkMode = false;
    private MudTheme _theme = ThemeService.CreateErpTheme();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await SignalRService.StartAsync();
        }
        catch { }
    }

    private void SetModule(ModuloSistema modulo, string route)
    {
        ModuleState.SetActiveModule(modulo);
        Nav.NavigateTo(route);
    }

    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        Nav.NavigateTo("login", true);
    }
}
