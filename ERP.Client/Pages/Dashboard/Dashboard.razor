@page "/"
@inject IMailingService MailingService
@inject ComercialService ComercialService
@inject FinanceiroService FinanceiroService
@inject SistemaService SistemaService
@inject IAuthService AuthService
@inject NavigationManager Nav
@inject ModuleStateService ModuleState

<PageTitle>Dashboard Geral - Azurra System</PageTitle>

<div class="d-flex justify-space-between align-center mb-6">
    <div>
        <MudText Typo="Typo.h4" Style="font-weight: 700; font-family: 'Outfit', sans-serif;">
            Visão Geral Executiva
        </MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            Monitoramento de indicadores comerciais, financeiros e operacionais em tempo real.
        </MudText>
    </div>
    <div class="d-flex gap-2">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd"
                   OnClick="@(() => { ModuleState.SetActiveModule(ModuloSistema.Comercial); Nav.NavigateTo("comercial/mailing/novo"); })">
            Novo Mailing
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Default" StartIcon="@Icons.Material.Filled.Refresh"
                   OnClick="LoadDataAsync">
            Atualizar
        </MudButton>
    </div>
</div>

<!-- KPI CARDS -->
<MudGrid Class="mb-6">
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Elevation="2" Class="pa-4 d-flex align-center justify-space-between erp-card-elevated" Style="border-left: 4px solid var(--mud-palette-primary);">
            <div>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-weight: 600; text-transform: uppercase;">Faturamento Mensal</MudText>
                <MudText Typo="Typo.h5" Style="font-weight: 700; margin-top: 4px;">R$ 185.300,00</MudText>
                <MudText Typo="Typo.caption" Color="Color.Success" Class="d-flex align-center mt-1">
                    <MudIcon Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small" Style="font-size: 14px;" /> +12.4% vs mês anterior
                </MudText>
            </div>
            <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Large">
                <MudIcon Icon="@Icons.Material.Filled.MonetizationOn" />
            </MudAvatar>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" sm="6" md="3">
        <MudPaper Elevation="2" Class="pa-4 d-flex align-center justify-space-between erp-card-elevated" Style="border-left: 4px solid var(--mud-palette-secondary);">
            <div>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-weight: 600; text-transform: uppercase;">Funil CRM (Pipeline)</MudText>
                <MudText Typo="Typo.h5" Style="font-weight: 700; margin-top: 4px;">R$ @_crmTotal.ToString("N2")</MudText>
                <MudText Typo="Typo.caption" Color="Color.Info" Class="d-flex align-center mt-1">
                    @_oportunidades.Count oportunidades ativas
                </MudText>
            </div>
            <MudAvatar Color="Color.Secondary" Variant="Variant.Filled" Size="Size.Large">
                <MudIcon Icon="@Icons.Material.Filled.ViewKanban" />
            </MudAvatar>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" sm="6" md="3">
        <MudPaper Elevation="2" Class="pa-4 d-flex align-center justify-space-between erp-card-elevated" Style="border-left: 4px solid var(--mud-palette-success);">
            <div>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-weight: 600; text-transform: uppercase;">Saldo em Caixa</MudText>
                <MudText Typo="Typo.h5" Style="font-weight: 700; margin-top: 4px;">R$ @(_fluxoCaixa?.SaldoBancos.ToString("N2") ?? "429.700,50")</MudText>
                <MudText Typo="Typo.caption" Color="Color.Success" Class="d-flex align-center mt-1">
                    2 contas bancárias conciliadas
                </MudText>
            </div>
            <MudAvatar Color="Color.Success" Variant="Variant.Filled" Size="Size.Large">
                <MudIcon Icon="@Icons.Material.Filled.AccountBalance" />
            </MudAvatar>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" sm="6" md="3">
        <MudPaper Elevation="2" Class="pa-4 d-flex align-center justify-space-between erp-card-elevated" Style="border-left: 4px solid var(--mud-palette-warning);">
            <div>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-weight: 600; text-transform: uppercase;">Total Clientes / Mailing</MudText>
                <MudText Typo="Typo.h5" Style="font-weight: 700; margin-top: 4px;">@_totalMailings</MudText>
                <MudText Typo="Typo.caption" Color="Color.Warning" Class="d-flex align-center mt-1">
                    Cadastros unificados
                </MudText>
            </div>
            <MudAvatar Color="Color.Warning" Variant="Variant.Filled" Size="Size.Large">
                <MudIcon Icon="@Icons.Material.Filled.Groups" />
            </MudAvatar>
        </MudPaper>
    </MudItem>
</MudGrid>

<!-- ATALHOS RÁPIDOS & PIPELINE DE OPORTUNIDADES -->
<MudGrid>
    <MudItem xs="12" lg="8">
        <MudCard Elevation="2" Class="mb-4">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6" Style="font-weight: 600;">Oportunidades em Aberto no Funil Comercial</MudText>
                </CardHeaderContent>
                <CardHeaderActions>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" EndIcon="@Icons.Material.Filled.ArrowForward"
                               OnClick="@(() => { ModuleState.SetActiveModule(ModuloSistema.Comercial); Nav.NavigateTo("comercial/crm"); })">
                        Ver Kanban Completo
                    </MudButton>
                </CardHeaderActions>
            </MudCardHeader>
            <MudCardContent Class="pa-0">
                <MudTable Items="@_oportunidades" Hover="true" Dense="true" Elevation="0">
                    <HeaderContent>
                        <MudTh>Oportunidade / Título</MudTh>
                        <MudTh>Cliente</MudTh>
                        <MudTh>Valor Estimado</MudTh>
                        <MudTh>Fase / Status</MudTh>
                        <MudTh>Probabilidade</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Título"><strong>@context.Titulo</strong></MudTd>
                        <MudTd DataLabel="Cliente">@context.ClienteNome</MudTd>
                        <MudTd DataLabel="Valor">R$ @context.ValorEstimado.ToString("N2")</MudTd>
                        <MudTd DataLabel="Status">
                            <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(context.Status)" Variant="Variant.Filled">
                                @context.Status
                            </MudChip>
                        </MudTd>
                        <MudTd DataLabel="Probabilidade">
                            <MudProgressLinear Color="Color.Primary" Value="@context.ProbabilidadePct" Size="Size.Small" Class="my-1" />
                            <MudText Typo="Typo.caption">@context.ProbabilidadePct%</MudText>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </MudCardContent>
        </MudCard>
    </MudItem>

    <MudItem xs="12" lg="4">
        <!-- LOGS DE AUDITORIA RECENTES -->
        <MudCard Elevation="2">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6" Style="font-weight: 600;">Auditoria & Logs Recentes</MudText>
                </CardHeaderContent>
                <CardHeaderActions>
                    <MudIconButton Icon="@Icons.Material.Filled.History" Color="Color.Default" OnClick="@(() => Nav.NavigateTo("sistema/audit"))" />
                </CardHeaderActions>
            </MudCardHeader>
            <MudCardContent>
                @if (_auditLogs.Any())
                {
                    <MudTimeline TimelineOrientation="TimelineOrientation.Vertical" TimelinePosition="TimelinePosition.Start">
                        @foreach (var log in _auditLogs.Take(4))
                        {
                            <MudTimelineItem Color="Color.Primary" Size="Size.Small">
                                <ItemContent>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        @log.DataHora.ToString("dd/MM HH:mm") · @log.UsuarioNome
                                    </MudText>
                                    <MudText Typo="Typo.body2" Style="font-weight: 600;">
                                        @log.Operacao em @log.Entidade
                                    </MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-size: 11px;">
                                        @log.Detalhes
                                    </MudText>
                                </ItemContent>
                            </MudTimelineItem>
                        }
                    </MudTimeline>
                }
                else
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Nenhum evento registrado recentemente.</MudText>
                }
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>

@code {
    private List<OportunidadeCrmDto> _oportunidades = new();
    private List<AuditLogDto> _auditLogs = new();
    private FluxoCaixaDto? _fluxoCaixa;
    private int _totalMailings = 0;
    private decimal _crmTotal => _oportunidades.Sum(o => o.ValorEstimado);

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        if (!AuthService.IsAuthenticated) return;

        try
        {
            var mailingRes = await MailingService.GetListAsync(new MailingFilterDto { PageSize = 1 });
            _totalMailings = mailingRes.TotalCount;

            _oportunidades = await ComercialService.GetOportunidadesAsync();
            _fluxoCaixa = await FinanceiroService.GetFluxoCaixaAsync();
            _auditLogs = await SistemaService.GetAuditLogsAsync();
        }
        catch { }
    }

    private Color GetStatusColor(StatusCrm status) => status switch
    {
        StatusCrm.Prospeccao => Color.Info,
        StatusCrm.Proposta => Color.Warning,
        StatusCrm.Negociacao => Color.Secondary,
        StatusCrm.Fechado => Color.Success,
        _ => Color.Default
    };
}
