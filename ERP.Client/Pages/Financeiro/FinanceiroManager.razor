@page "/financeiro"
@inject FinanceiroService FinanceiroService
@inject ISnackbar Snackbar

<PageTitle>Painel Financeiro - ERP Web Matrix</PageTitle>

<div class="d-flex justify-space-between align-center mb-4">
    <div>
        <MudText Typo="Typo.h5" Style="font-weight: 700; font-family: 'Outfit', sans-serif;">
            Gestão Financeira e Fluxo de Caixa
        </MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            Controle integrado de contas a pagar, contas a receber, conciliação e liquidação.
        </MudText>
    </div>
</div>

<!-- CARDS DE FLUXO DE CAIXA -->
<MudGrid Class="mb-4">
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Elevation="2" Class="pa-4">
            <MudText Typo="Typo.caption" Color="Color.Secondary">Disponível em Bancos</MudText>
            <MudText Typo="Typo.h6" Color="Color.Primary" Style="font-weight: 700;">
                R$ @(_fluxo?.SaldoBancos.ToString("N2") ?? "0,00")
            </MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Elevation="2" Class="pa-4">
            <MudText Typo="Typo.caption" Color="Color.Secondary">A Receber no Mês</MudText>
            <MudText Typo="Typo.h6" Color="Color.Success" Style="font-weight: 700;">
                R$ @(_fluxo?.TotalReceberMes.ToString("N2") ?? "0,00")
            </MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Elevation="2" Class="pa-4">
            <MudText Typo="Typo.caption" Color="Color.Secondary">A Pagar no Mês</MudText>
            <MudText Typo="Typo.h6" Color="Color.Error" Style="font-weight: 700;">
                R$ @(_fluxo?.TotalPagarMes.ToString("N2") ?? "0,00")
            </MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Elevation="2" Class="pa-4">
            <MudText Typo="Typo.caption" Color="Color.Secondary">Saldo Projetado Final</MudText>
            <MudText Typo="Typo.h6" Color="Color.Info" Style="font-weight: 700;">
                R$ @(_fluxo?.SaldoProjetadoMes.ToString("N2") ?? "0,00")
            </MudText>
        </MudPaper>
    </MudItem>
</MudGrid>

<!-- ABAS DE CONTAS -->
<MudPaper Elevation="2" Class="pa-2">
    <MudTabs @bind-ActivePanelIndex="_tabIndex" Elevation="0" Rounded="true" ApplyEffectsToContainer="true">
        <MudTabPanel Text="Todos os Lançamentos" Icon="@Icons.Material.Filled.List">
            <MudTable Items="@_titulos" Dense="true" Hover="true" Striped="true">
                <HeaderContent>
                    <MudTh>Tipo</MudTh>
                    <MudTh>Documento</MudTh>
                    <MudTh>Sacado / Cedente</MudTh>
                    <MudTh>Vencimento</MudTh>
                    <MudTh>Valor Original</MudTh>
                    <MudTh>Saldo Aberto</MudTh>
                    <MudTh>Forma Pagto</MudTh>
                    <MudTh>Status</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>
                        <MudChip T="string" Size="Size.Small" Color="@(context.Tipo == TipoTitulo.Receber ? Color.Success : Color.Error)">
                            @context.Tipo
                        </MudChip>
                    </MudTd>
                    <MudTd><strong>@context.NumeroDocumento</strong></MudTd>
                    <MudTd>@context.SacadoCedenteNome</MudTd>
                    <MudTd>@context.DataVencimento.ToString("dd/MM/yyyy")</MudTd>
                    <MudTd>R$ @context.ValorOriginal.ToString("N2")</MudTd>
                    <MudTd><strong>R$ @context.ValorSaldo.ToString("N2")</strong></MudTd>
                    <MudTd>@context.FormaPagamento</MudTd>
                    <MudTd>
                        <MudChip T="string" Size="Size.Small" Color="@(context.Status == StatusTitulo.Pendente ? Color.Warning : Color.Success)" Variant="Variant.Text">
                            @context.Status
                        </MudChip>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudTabPanel>

        <MudTabPanel Text="Contas a Pagar" Icon="@Icons.Material.Filled.TrendingDown">
            <MudTable Items="@_titulos.Where(x => x.Tipo == TipoTitulo.Pagar)" Dense="true" Hover="true">
                <HeaderContent>
                    <MudTh>Documento</MudTh>
                    <MudTh>Fornecedor / Favorecido</MudTh>
                    <MudTh>Vencimento</MudTh>
                    <MudTh>Valor</MudTh>
                    <MudTh>Status</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.NumeroDocumento</MudTd>
                    <MudTd>@context.SacadoCedenteNome</MudTd>
                    <MudTd>@context.DataVencimento.ToString("dd/MM/yyyy")</MudTd>
                    <MudTd>R$ @context.ValorSaldo.ToString("N2")</MudTd>
                    <MudTd><MudChip T="string" Size="Size.Small" Color="Color.Warning">@context.Status</MudChip></MudTd>
                </RowTemplate>
            </MudTable>
        </MudTabPanel>

        <MudTabPanel Text="Contas a Receber" Icon="@Icons.Material.Filled.TrendingUp">
            <MudTable Items="@_titulos.Where(x => x.Tipo == TipoTitulo.Receber)" Dense="true" Hover="true">
                <HeaderContent>
                    <MudTh>Documento</MudTh>
                    <MudTh>Cliente</MudTh>
                    <MudTh>Vencimento</MudTh>
                    <MudTh>Valor</MudTh>
                    <MudTh>Status</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.NumeroDocumento</MudTd>
                    <MudTd>@context.SacadoCedenteNome</MudTd>
                    <MudTd>@context.DataVencimento.ToString("dd/MM/yyyy")</MudTd>
                    <MudTd>R$ @context.ValorSaldo.ToString("N2")</MudTd>
                    <MudTd><MudChip T="string" Size="Size.Small" Color="Color.Warning">@context.Status</MudChip></MudTd>
                </RowTemplate>
            </MudTable>
        </MudTabPanel>
    </MudTabs>
</MudPaper>

@code {
    private int _tabIndex = 0;
    private List<TituloFinanceiroDto> _titulos = new();
    private FluxoCaixaDto? _fluxo;

    protected override async Task OnInitializedAsync()
    {
        _titulos = await FinanceiroService.GetTitulosAsync();
        _fluxo = await FinanceiroService.GetFluxoCaixaAsync();
    }
}
